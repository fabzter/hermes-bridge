#!/usr/bin/env bash
#
# hermes-bridge — tmux communication bridge for driving the local Hermes Agent
# CLI (`hermes chat --cli`) interactively from Claude Code.
#
# Subcommands: start, send, send-file, wait, peek, state, approve, deny, stop, log
#
# Exit codes:
#   0  success (idle reached / command completed)
#   1  generic error (bad usage, missing file, wrong state for approve/deny, ...)
#   2  tmux session is missing (required for this subcommand)
#   3  approval-needed state reached (⚠)
#   4  secret-needed state reached (🔐 / 🔑)
#   5  clarify-needed state reached (?/✎)
#   6  timeout waiting for idle / action-needed state
#   7  session is present but the pane process has died ("dead")
#   8  send/send-file refused: session is busy (would silently interrupt
#      in-flight work — Hermes's busy hint is literally "msg=interrupt")
#
# Codes 3-6 are mandated verbatim by the task brief. Codes 2, 7, and 8 are
# this script's own extension: 2/7 give the "missing"/"dead" entries of the
# `state` enum a distinct, scriptable exit code on commands that require a
# live session (state itself always exits 0 — see `cmd_state`); 8 is a
# send-specific pre-send rejection, never returned by `wait`/`start`.
#
# Safety: this script NEVER passes --yolo/--accept-hooks to hermes and NEVER
# auto-answers an approval/secret/clarify prompt. approve/deny only ever act
# when explicitly invoked by the caller.

set -euo pipefail

# Pin a UTF-8 locale (cheap, defense-in-depth): under the unset/C locale on
# this machine's bash 3.2, the regex engine mishandles multi-byte UTF-8
# characters inside `[...]` bracket expressions (confirmed live — see the
# comments on is_blank_or_separator_line and read_menu). All such regexes
# in this script were rewritten to avoid bracket expressions around
# multi-byte characters regardless, but pinning the locale removes the
# underlying hazard for any future change that adds one back.
export LC_ALL=en_US.UTF-8

# ---------------------------------------------------------------------------
# Constants / defaults
# ---------------------------------------------------------------------------

DEFAULT_SESSION="hermes-bridge"
DEFAULT_TIMEOUT=120
POLL_INTERVAL=0.4
STOP_GRACE_SECONDS=5
HERMES_LOG="$HOME/.hermes/logs/agent.log"
PASTE_BUFFER_NAME="hermes-bridge-msg"
# tmux session user-option used to mark a session as one this script
# created, so --session NAME (accepted on every subcommand, not just
# start's documented signature — see the README-level deviation note) can
# never respawn/kill/type into an arbitrary session the user happens to
# already have running under that name (I11).
SESSION_MARKER="@hermes_bridge_managed"
# tmux session user-option + on-disk file used to persist the underlying
# Hermes session id, so a crash-and-relaunch (or a plain stop/start) can
# --resume the SAME conversation instead of starting fresh (R1/R2). The
# file is the durable copy — it survives even a fully-destroyed tmux
# session/server, which the tmux option cannot.
HERMES_SESSION_ID_OPTION="@hermes_bridge_session_id"
STATE_DIR="$HOME/.claude/skills/hermes-bridge/state"

SESSION="$DEFAULT_SESSION"

# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

err() { printf '%s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
usage: hermes-bridge <command> [options]

commands:
  start [--session NAME] [--timeout N] [--fresh]
  send [--session NAME] [--timeout N] MESSAGE
  send-file [--session NAME] [--timeout N] FILE
  wait [--session NAME] [--timeout N]
  peek [--session NAME] [-n LINES]
  state [--session NAME]
  session [--session NAME]
  approve [--session NAME]
  deny [--session NAME] [REASON...]
  stop [--session NAME]
  log [-n N]

exit codes: 0 ok, 1 error, 2 session missing, 3 approval, 4 secret,
            5 clarify, 6 timeout, 7 session dead, 8 busy (send/send-file only)
EOF
}

# tmux session helpers -------------------------------------------------------

session_exists() {
  tmux has-session -t "$SESSION" 2>/dev/null
}

# (N3) Liveness must come from the actual process tree, not prompt
# cosmetics. An earlier version (I10) inferred "dead" from
# pane_current_command being a shell PLUS the last visible line looking
# like a settled shell prompt (ending in a bare "%"/"$") — but a
# fancy/custom shell prompt (starship, pure, etc.) ending in "❯" would
# satisfy classify_state's IDLE glyph check instead, and a crashed pane
# would then be misreported as a perfectly healthy idle Hermes session,
# with `send` going on to paste the message into a bare shell and Enter
# executing it. Liveness now walks the pane's actual process tree instead:
# the pane's own registered process (covers the argv-launch path, where
# hermes IS the pane's process directly — see cmd_start) or one of its
# direct children (covers the typed-into-shell launch path, where hermes
# runs as a child job of the pane's shell — confirmed live during the R4
# crash test: exactly one hop deep via `pgrep -P`, no deeper nesting, since
# ~/.local/bin/hermes's own wrapper `exec`s into the real interpreter
# rather than forking). Prompt-glyph checks are dropped from the liveness
# decision entirely, per this finding — they were the actual bug.
pane_has_live_hermes_process() {
  local root_pid
  # (NB1) Dropped the `| head -1` pipe: under `set -e -o pipefail`, if the
  # tmux session vanishes mid-call (the normal crash path for a direct-argv
  # launch — see N3/N1c above, hermes exiting destroys its own session),
  # `tmux list-panes` exits 1, pipefail propagates that through the pipe
  # regardless of `head`'s own success, and the bare assignment aborts the
  # whole script with rc=1 instead of the documented state/exit codes.
  # `display-message -p` returns exactly one line on its own, so no pipe
  # (and no head) is needed at all; guarded the same way as the sibling
  # tmux calls at pane_has_live_hermes_process's own `ps` lines and
  # pane_is_dead/session_is_managed below.
  root_pid="$(tmux display-message -t "$SESSION" -p '#{pane_pid}' 2>/dev/null || true)"
  [[ -z "$root_pid" ]] && return 1

  local cmd
  cmd="$(ps -o command= -p "$root_pid" 2>/dev/null || echo "")"
  [[ "$cmd" == *"hermes-agent"* ]] && return 0

  local child_pid
  for child_pid in $(pgrep -P "$root_pid" 2>/dev/null || true); do
    cmd="$(ps -o command= -p "$child_pid" 2>/dev/null || echo "")"
    [[ "$cmd" == *"hermes-agent"* ]] && return 0
  done

  return 1
}

pane_is_dead() {
  local flag
  flag="$(tmux display-message -t "$SESSION" -p '#{pane_dead}' 2>/dev/null || echo "")"
  [[ "$flag" == "1" ]] && return 0

  if pane_has_live_hermes_process; then
    return 1
  fi
  return 0
}

# (I11) Marks/checks tmux-session ownership. --session NAME is accepted on
# every subcommand (a deliberate deviation from the brief, which only
# documents it under `start`), which means a caller could point send/stop/
# etc. at any session name — including one the user already has open for
# something unrelated. Every operation that writes into, respawns, or kills
# a session must first confirm THIS script created it.
mark_session_managed() {
  tmux set-option -t "$SESSION" "$SESSION_MARKER" 1 2>/dev/null || true
}

session_is_managed() {
  local v
  v="$(tmux show-options -t "$SESSION" -v "$SESSION_MARKER" 2>/dev/null || echo "")"
  [[ "$v" == "1" ]]
}

# Call after confirming the target session exists (or via a command that
# already implies it does, e.g. classify_state having ruled out "missing")
# and before any respawn-pane/kill-session/send-keys/paste-buffer call.
# No-ops when the session doesn't exist yet (start's create-new path marks
# it immediately after creation instead).
require_managed_session_or_die() {
  if session_exists && ! session_is_managed; then
    err "hermes-bridge: session '$SESSION' exists but was not created by hermes-bridge (no $SESSION_MARKER marker); refusing to touch it"
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Hermes session-id persistence (R1/R2/R3)
#
# Verified live: the plain startup banner (no extra flag needed) prints a
# line "Session: <id>" (format confirmed live across many launches:
# YYYYMMDD_HHMMSS_hex6, e.g. "20260819_200013_e651fb") as part of the
# "Available Tools" box shown on every launch — fresh OR resumed. This is
# simpler and less invasive than --pass-session-id (which only injects the
# id into Hermes's OWN system prompt, for Hermes's benefit, not ours) or
# shelling out to a separate `hermes sessions list` call, so it's what
# capture_session_id_from_pane scrapes. `--resume <id>` (not `--continue`,
# which resumes by name/most-recent rather than a specific id) is the flag
# verified live to continue the exact same conversation.
#
# (N1, Critical) The first version of this scraped `Session: <id>` from the
# ENTIRE scrollback with no format check, then interpolated the result
# straight into a shell command STRING typed into the pane. Both halves of
# that are a real injection: Hermes's own output is not trusted input — a
# reply (or a prompt-injected instruction hidden in something Hermes reads)
# containing a line like "Session: ;touch $HOME/PWNED" would be scraped as
# if it were the real id, persisted to the state file, and then on the next
# start/relaunch typed into a live shell where the semicolon runs as a
# second command. Fixed three ways: (a) strict format validation before
# EVERY save and EVERY load; (b) the scrape is now anchored to the startup
# banner box specifically (identified by "Hermes Agent" in its own top
# border), not searched across arbitrary later conversation content;
# (c) the id is now only ever passed as an argv element (respawn-pane, and
# — new this round — a direct-argv `new-session` when a saved id is being
# resumed), never substituted into a string that gets typed into a shell —
# see cmd_start.
# ---------------------------------------------------------------------------

# Confirmed live, repeatedly, across many launches this build: 8 digits,
# underscore, 6 digits, underscore, 6 lowercase hex chars.
is_valid_session_id() {
  [[ "$1" =~ ^[0-9]{8}_[0-9]{6}_[0-9a-f]{6}$ ]]
}

session_id_file() {
  printf '%s/%s.session-id' "$STATE_DIR" "$SESSION"
}

save_session_id() {
  local id="$1"
  if ! is_valid_session_id "$id"; then
    err "hermes-bridge: refusing to save malformed session id: $id"
    return 1
  fi
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  printf '%s' "$id" > "$(session_id_file)"
  tmux set-option -t "$SESSION" "$HERMES_SESSION_ID_OPTION" "$id" 2>/dev/null || true
  return 0
}

load_session_id() {
  local f sid
  f="$(session_id_file)"
  # "no saved id yet" (the normal first-run case), or a saved id that
  # fails format validation (e.g. a stale file from before this fix, or
  # hand-edited), must be a successful, empty result, not a failure --
  # under `set -e`, a bare failing test as the last statement of a
  # function killed the whole script the first time this ran (confirmed
  # live previously). Always `return 0`.
  if [[ -r "$f" ]]; then
    sid="$(cat "$f")"
    if is_valid_session_id "$sid"; then
      printf '%s' "$sid"
    else
      err "hermes-bridge: ignoring malformed saved session id"
    fi
  fi
  return 0
}

clear_session_id() {
  rm -f "$(session_id_file)" 2>/dev/null || true
}

# (N1b) Scrapes the id from the STARTUP banner specifically, not the whole
# accumulated scrollback. The banner's own top border literally contains
# "Hermes Agent v<version>" (e.g. "╭──... Hermes Agent v0.20.0 ...──╮"),
# which no ordinary conversation turn would produce, so anchoring on it
# means later chat content that merely CONTAINS a "Session: ..."-shaped
# line (trivially producible by asking Hermes to print one, or via prompt
# injection) is never even considered. Searches backward for the MOST
# RECENT such banner (a respawned pane can still carry an older banner
# earlier in its scrollback from a prior crash cycle within the same tmux
# session). Echoes the id only if it also passes is_valid_session_id;
# echoes nothing if no banner, no id line within it, or a malformed id is
# found — callers treat "not found" as non-fatal.
capture_session_id_from_pane() {
  local full
  full="$(capture_full)"
  local -a lines=()
  local line
  while IFS= read -r line; do
    lines+=("$line")
  done <<<"$full"

  local n=${#lines[@]}
  local top_idx=-1
  local i
  for (( i=n-1; i>=0; i-- )); do
    # Must be the box's actual TOP BORDER line (starts with ╭), not just
    # any line containing "Hermes Agent" — the plain welcome message
    # ("Welcome to Hermes Agent! Type your message or /help for commands.")
    # printed just BELOW the real banner box also contains that substring
    # and, being later in scrollback, was found first by a bare substring
    # search — confirmed live, this made the whole scrape silently fail
    # every time (top_idx anchored on the welcome line, which isn't inside
    # any box, so no bottom border / no "Session:" was ever found after it).
    if [[ "${lines[$i]}" == *"Hermes Agent"* ]] && is_box_top_border_line "${lines[$i]}"; then
      top_idx=$i
      break
    fi
  done
  (( top_idx < 0 )) && return 1

  local bottom_idx=$((n - 1))
  for (( i=top_idx+1; i<n; i++ )); do
    if is_box_bottom_border_line "${lines[$i]}"; then
      bottom_idx=$i
      break
    fi
  done

  local sid
  for (( i=top_idx; i<=bottom_idx; i++ )); do
    sid="$(printf '%s\n' "${lines[$i]}" | sed -n 's/.*Session: \([^ ]*\).*/\1/p')"
    if [[ -n "$sid" ]] && is_valid_session_id "$sid"; then
      printf '%s' "$sid"
      return 0
    fi
  done
  return 1
}

# Visible-screen capture only (no scrollback) — used for state polling.
capture_visible() {
  tmux capture-pane -p -t "$SESSION" 2>/dev/null || true
}

# Full history + visible screen, wrapped lines joined — used for response
# extraction.
#
# capture-pane -S - (no -E) captures from the start of history down through
# the *entire* visible pane height, blank padding rows included. That
# padding is fixed-size (the pane's configured height) and gets consumed
# in place as new content is typed — confirmed empirically: newly-echoed
# input can land at a physical line number *lower* than a "before" wc -l
# snapshot taken moments earlier, because prompt_toolkit redraws its bottom
# toolbar/prompt chrome via cursor addressing rather than pure append. That
# makes an absolute line-count high-water mark imprecise (by a handful of
# lines) for this particular TUI's rendering model, so response extraction
# below uses the line count only as a loose anchor with a safety margin,
# then locates the echo by content near that point — see extract_response.
capture_full() {
  local raw
  raw="$(tmux capture-pane -p -J -S - -t "$SESSION" 2>/dev/null || true)"
  # Trim trailing blank padding lines so downstream line-index math (used
  # only for bookkeeping/logging, not for locating the echo) isn't thrown
  # off by the pane's fixed visible height.
  printf '%s\n' "$raw" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}'
}

is_blank_or_separator_line() {
  local l="$1"
  local stripped="${l//[[:space:]]/}"
  [[ -z "$stripped" ]] && return 0
  # Byte-safe glob substitution rather than a `[...]` regex bracket
  # expression: bash 3.2's regex engine mishandles multi-byte UTF-8 chars
  # inside bracket expressions under the C/POSIX locale (confirmed live —
  # `[│]` silently broke alignment for anything matched right after it,
  # even though the identical bare literal `│` outside brackets works
  # fine). `${var//char/}` glob substitution does not have this problem.
  stripped="${stripped//─/}"
  stripped="${stripped//━/}"
  stripped="${stripped//═/}"
  stripped="${stripped//╭/}"
  stripped="${stripped//╮/}"
  stripped="${stripped//╰/}"
  stripped="${stripped//╯/}"
  stripped="${stripped//│/}"
  [[ -z "$stripped" ]] && return 0
  return 1
}

# Returns the last line that is neither blank nor a pure box-drawing/
# separator row. Plain "last non-blank" (e.g. awk 'NF') is NOT enough here:
# the pane's actual bottom row is very often a decorative "────..." border
# (non-blank, but content-free) sitting *below* the real prompt line —
# confirmed empirically, this masked the idle prompt entirely on the first
# implementation attempt.
last_meaningful_line() {
  local text="$1"
  local -a arr=()
  while IFS= read -r l; do
    arr+=("$l")
  done <<<"$text"
  local i
  for (( i=${#arr[@]}-1; i>=0; i-- )); do
    if ! is_blank_or_separator_line "${arr[$i]}"; then
      printf '%s\n' "${arr[$i]}"
      return
    fi
  done
  echo ""
}

# ---------------------------------------------------------------------------
# State classification
#
# Empirically confirmed against a live Hermes v0.20.0 session:
#   idle prompt line:  bare "❯" (tmux capture-pane trims trailing spaces, so
#                       there is never a trailing space to match on)
#   busy prompt line:  "⚕ ❯ msg=interrupt · /queue · /bg · /steer · Ctrl+C cancel"
#                       (extra hint text after the glyphs — this is what
#                       distinguishes it from idle)
#   banner text can contain ⚠ (e.g. "⚠ 1 commit behind") several lines above
#   the prompt — restricting the check to the LAST non-blank line only is
#   what avoids that false positive.
#
# approval (⚠) was confirmed live: triggering a real dangerous-command
# approval prompt renders the bottom prompt line as literally "⚠ ❯" (glyph,
# space, then the normal idle glyph) — the same "decorator prefixed onto
# the prompt" pattern already confirmed for busy ("⚕ ❯ msg=interrupt..."),
# but WITHOUT busy's trailing hint text. That means it still satisfies a
# naive "ends in ❯" test, so the special-glyph checks below MUST run
# before the idle check, not after — an earlier version of this function
# had idle first and silently misreported a live approval prompt as idle.
# secret (🔐/🔑) and clarify (✎ or bare ?) were not observed live (no safe
# way to trigger them here); implemented by analogy with the confirmed
# approval/busy pattern and the research brief's documented glyph set —
# treat as best-effort pending real-world confirmation.
# ---------------------------------------------------------------------------

classify_state() {
  if ! session_exists; then
    echo "missing"
    return
  fi
  if pane_is_dead; then
    echo "dead"
    return
  fi

  local screen last
  screen="$(capture_visible)"
  last="$(last_meaningful_line "$screen")"

  if [[ "$last" == *"🔐"* || "$last" == *"🔑"* ]]; then
    echo "secret"
    return
  fi
  if [[ "$last" == *"⚠"* ]]; then
    echo "approval"
    return
  fi
  if [[ "$last" == *"✎"* ]]; then
    echo "clarify"
    return
  fi
  # Bare "?" clarify marker: only trust it in the same structural position
  # the confirmed busy glyph occupies (glyph, then "❯", i.e. "? ❯ ...").
  if [[ "$last" =~ ^[[:space:]]*[?][[:space:]]+❯ ]]; then
    echo "clarify"
    return
  fi

  # idle: line ends exactly in the ❯ glyph, nothing after it (profile name
  # may precede it, e.g. "work ❯"). Must run after the special-glyph checks
  # above, since e.g. "⚠ ❯" also satisfies "ends in ❯".
  if [[ "$last" =~ ❯$ ]]; then
    echo "idle"
    return
  fi

  echo "busy"
}

# ---------------------------------------------------------------------------
# Polling loop: block until idle (with stability check) or an action-needed
# terminal state, or timeout.
#
# The obvious "two identical full captures" reading of the stability
# requirement does not survive contact with the real UI: Hermes renders a
# live per-second footer/timer ("│ 51s │ ✓ 1s") that changes every poll even
# while the prompt itself is genuinely idle, so a full-pane byte-compare
# would never stabilize. Stability is instead defined as: classify_state()
# reports "idle" on two consecutive polls AND the last non-blank prompt line
# is byte-identical between those two polls (the part that actually matters
# for "is the input line settled").
#
# $2 (optional, require_echo): a substring that must appear in the pane
# before an "idle" reading is allowed to count at all (I9). Without this,
# `send`/`send-file` had a real race: hermes can take long enough to start
# rendering a new turn that the FIRST one or two polls right after send
# still see the stale, pre-send idle prompt — satisfying the stability
# check against itself and returning "idle" before hermes ever started
# working. wait/start/approve/deny don't pass this (empty = no gate),
# preserving their "already idle counts immediately" semantics.
# ---------------------------------------------------------------------------

wait_for_terminal() {
  local timeout="$1"
  local require_echo="${2:-}"
  local start_ts now elapsed
  local prev_state="" prev_last=""
  local cur_state cur_last screen
  local seen_activity=false
  [[ -z "$require_echo" ]] && seen_activity=true

  start_ts="$(date +%s)"
  while true; do
    now="$(date +%s)"
    elapsed=$((now - start_ts))
    if (( elapsed >= timeout )); then
      echo "timeout"
      return
    fi

    cur_state="$(classify_state)"

    case "$cur_state" in
      missing|dead)
        # Require the same dead/missing reading twice in a row before
        # treating it as terminal. The hermes launcher (~/.local/bin/hermes)
        # is itself a bash wrapper that execs into the real interpreter —
        # confirmed live, a single unlucky poll can catch that transient
        # in-between moment (pane_current_command briefly reads as a plain
        # shell) and misreport a perfectly healthy (re)launch as dead.
        if [[ "$prev_state" == "$cur_state" ]]; then
          echo "$cur_state"
          return
        fi
        prev_state="$cur_state"
        ;;
      approval|secret|clarify)
        seen_activity=true
        echo "$cur_state"
        return
        ;;
      idle)
        screen="$(capture_visible)"
        if ! $seen_activity; then
          if [[ "$screen" == *"$require_echo"* ]]; then
            seen_activity=true
          else
            # (I9) stale pre-send idle prompt — hermes hasn't started
            # rendering the new turn yet. Don't let this count.
            prev_state=""
            prev_last=""
            sleep "$POLL_INTERVAL"
            continue
          fi
        fi
        cur_last="$(last_meaningful_line "$screen")"
        if [[ "$prev_state" == "idle" && "$cur_last" == "$prev_last" ]]; then
          echo "idle"
          return
        fi
        prev_state="idle"
        prev_last="$cur_last"
        ;;
      busy)
        seen_activity=true
        prev_state="busy"
        prev_last=""
        ;;
    esac

    sleep "$POLL_INTERVAL"
  done
}

state_exit_code() {
  case "$1" in
    idle) echo 0 ;;
    approval) echo 3 ;;
    secret) echo 4 ;;
    clarify) echo 5 ;;
    timeout) echo 6 ;;
    missing) echo 2 ;;
    dead) echo 7 ;;
    # (Fix-wave item 2) busy is rejected as a pre-send state (see cmd_send/
    # cmd_send_file) with its own distinct code, same pattern as the other
    # named states — never returned by wait_for_terminal itself (busy is
    # always transient there, not a terminal value), so this mapping only
    # ever fires from that one pre-send rejection path.
    busy) echo 8 ;;
    *) echo 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# Sending input
# ---------------------------------------------------------------------------

# Sends arbitrary text (single-line or multi-line) as one atomic paste, then
# Enter. Used for both `send` and `send-file` — they no longer need
# separate code paths (see (I8) below).
#
# (I8) Payload used to be passed as a `tmux send-keys -l --`/`tmux
# set-buffer --` ARGUMENT. tmux parses its own argument list for its own
# command-separator syntax (`;` chains multiple tmux commands in one
# invocation) — an unescaped `;` inside a payload passed as a tmux argv
# element can be swallowed/misinterpreted by tmux's own parser even though
# the shell already quoted it correctly. `tmux load-buffer -b NAME -` reads
# the payload from stdin instead of argv, bypassing tmux's own
# command-string parsing entirely, so a trailing (or embedded) `;` — or any
# other character — survives byte-for-byte.
#
# -p on paste-buffer is still the critical flag for multi-line content: it
# wraps the paste in bracketed-paste control codes so Hermes's input widget
# treats embedded newlines as literal content. WITHOUT -p, tmux's default
# behavior replaces each LF with a CR separator and — confirmed
# empirically — that CR can trigger a premature submit partway through the
# message, splitting one multi-line message into multiple sends. Using the
# same -p path for single-line sends too is harmless (zero embedded
# newlines, nothing for bracketed-paste handling to do differently) and
# removes the need for a separate literal-send-keys code path entirely.
send_payload() {
  local content="$1"
  printf '%s' "$content" | tmux load-buffer -b "$PASTE_BUFFER_NAME" -
  tmux paste-buffer -p -d -b "$PASTE_BUFFER_NAME" -t "$SESSION"
  tmux send-keys -t "$SESSION" Enter
}

# ---------------------------------------------------------------------------
# Approval-menu navigation
#
# CRITICAL correction found during live testing: the ⚠ approval prompt is
# NOT a slash-command context. It is an arrow-key-navigated numbered menu
# ("1. Allow once / 2. Allow for this session / 3. Add to permanent
# allowlist / 4. Deny", footer literally says "↑/↓ to select, Enter to
# confirm"). An earlier version of this script sent the literal text
# "/deny <reason>" + Enter into that menu — the menu ignored the typed
# characters and Enter simply confirmed whatever option was already
# highlighted (the default, "1. Allow once"), causing an ACCIDENTAL
# APPROVAL of a real dangerous command in live testing (harmless in that
# instance only because the test command's target path never existed).
# approve/deny now parse the actual menu, step the cursor there one key at
# a time, and re-read the pane after every keypress to confirm the cursor
# really landed on the intended option before ever sending Enter — this
# script must never send Enter into this menu without first verifying
# option-by-option where the cursor is.
# ---------------------------------------------------------------------------

is_box_top_border_line() {
  # Strip whitespace via substitution FIRST, then a plain prefix glob on
  # the result — combining `[[:space:]]*` directly with a multi-byte
  # literal in one glob pattern (e.g. `[[:space:]]*╭*`) hits the same
  # bash-3.2-under-this-locale byte-alignment bug found in the regex
  # engine, just in fnmatch this time: confirmed live, that combined
  # pattern silently never matched, even the simplest "╭" case.
  local stripped="${1//[[:space:]]/}"
  case "$stripped" in
    ╭*) return 0 ;;
    *) return 1 ;;
  esac
}

is_box_bottom_border_line() {
  local stripped="${1//[[:space:]]/}"
  case "$stripped" in
    ╰*) return 0 ;;
    *) return 1 ;;
  esac
}

# (C2) Parses ONLY the contiguous numbered-option block bounded by its own
# box (the nearest ╭...╮ / ╰...╯ pair immediately preceding the
# "↑/↓ to select, Enter to confirm" footer) — NOT the whole pane. Scanning
# the whole pane for "N. Label" lines is unsafe: reproduced live, a numbered
# list in Hermes's own PROSE (e.g. a reply containing "2. Deny and
# rework...") is indistinguishable from the real menu and can make `deny`
# confirm the wrong real option. Also requires the parsed option numbers to
# form a unique ascending 1..N run (no gaps, no repeats) — a decoy list
# elsewhere wouldn't reliably satisfy that shape. Populates the global
# arrays MENU_NUMS/MENU_LABELS and MENU_SELECTED (the number currently
# marked with the ❯ cursor). Returns non-zero, with all three cleared, if
# no well-formed menu can be resolved this way.
read_menu() {
  MENU_NUMS=()
  MENU_LABELS=()
  MENU_SELECTED=""

  local screen
  screen="$(capture_visible)"
  local -a lines=()
  local line
  while IFS= read -r line; do
    lines+=("$line")
  done <<<"$screen"

  local n=${#lines[@]}
  local footer_idx=-1
  local i
  for (( i=n-1; i>=0; i-- )); do
    if [[ "${lines[$i]}" == *"to select"* && "${lines[$i]}" == *"Enter to confirm"* ]]; then
      footer_idx=$i
      break
    fi
  done
  (( footer_idx < 0 )) && return 1

  local bottom_idx=-1
  for (( i=footer_idx-1; i>=0; i-- )); do
    if is_box_bottom_border_line "${lines[$i]}"; then
      bottom_idx=$i
      break
    fi
  done
  (( bottom_idx < 0 )) && return 1

  local top_idx=-1
  for (( i=bottom_idx-1; i>=0; i-- )); do
    if is_box_top_border_line "${lines[$i]}"; then
      top_idx=$i
      break
    fi
  done
  (( top_idx < 0 )) && return 1

  local expected=1
  for (( i=top_idx+1; i<bottom_idx; i++ )); do
    line="${lines[$i]}"
    # Bare literal │ (not a `[...]` bracket expression) — see the note in
    # is_blank_or_separator_line about bash 3.2's bracket-expression bug
    # with multi-byte UTF-8 characters under this locale.
    if [[ "$line" =~ ^[[:space:]]*│?[[:space:]]*(❯[[:space:]]*)?([0-9]+)\.[[:space:]]+(.*)$ ]]; then
      local num="${BASH_REMATCH[2]}"
      local label="${BASH_REMATCH[3]}"
      if [[ "$num" != "$expected" ]]; then
        # Not a clean ascending unique run starting at 1 — treat the whole
        # block as unresolvable rather than guess.
        MENU_NUMS=()
        MENU_LABELS=()
        MENU_SELECTED=""
        return 1
      fi
      MENU_NUMS+=("$num")
      MENU_LABELS+=("$label")
      if [[ -n "${BASH_REMATCH[1]}" ]]; then
        MENU_SELECTED="$num"
      fi
      expected=$((expected + 1))
    fi
  done

  (( ${#MENU_NUMS[@]} > 0 ))
}

# Finds the option number whose label matches (substring) $1. Echoes the
# number, or nothing if not found.
find_menu_option() {
  local pattern="$1"
  local i
  for i in "${!MENU_LABELS[@]}"; do
    if [[ "${MENU_LABELS[$i]}" == *"$pattern"* ]]; then
      echo "${MENU_NUMS[$i]}"
      return 0
    fi
  done
  return 1
}

# Steps the menu cursor to $1 (a menu option number) one keypress at a
# time, re-reading the pane after each press to confirm the cursor actually
# moved as expected. $2 is the label pattern that option was chosen for.
# Presses Enter only once BOTH the option NUMBER is confirmed selected AND
# (C2c) the selected option's LABEL is re-verified to match $2 — gating on
# the number alone isn't enough if the menu were ever reparsed differently
# between polls. Returns non-zero (without ever pressing Enter) if the
# cursor cannot be confirmed on the target within a bounded number of
# attempts.
select_menu_option_and_confirm() {
  local target="$1"
  local target_pattern="$2"
  local attempts=0
  local max_attempts=10

  if ! read_menu; then
    return 1
  fi
  while (( attempts < max_attempts )); do
    if [[ "$MENU_SELECTED" == "$target" ]]; then
      local idx=-1
      local j
      for j in "${!MENU_NUMS[@]}"; do
        if [[ "${MENU_NUMS[$j]}" == "$MENU_SELECTED" ]]; then
          idx=$j
          break
        fi
      done
      if (( idx < 0 )) || [[ "${MENU_LABELS[$idx]}" != *"$target_pattern"* ]]; then
        return 1
      fi
      tmux send-keys -t "$SESSION" Enter
      return 0
    fi
    if [[ -z "$MENU_SELECTED" ]]; then
      return 1
    fi
    if (( MENU_SELECTED < target )); then
      tmux send-keys -t "$SESSION" Down
    else
      tmux send-keys -t "$SESSION" Up
    fi
    sleep 0.2
    if ! read_menu; then
      return 1
    fi
    attempts=$((attempts + 1))
  done
  return 1
}

# ---------------------------------------------------------------------------
# Response extraction: locate the echoed input by content near a recorded
# pre-send line-count anchor (see extract_response for why a precise offset
# can't be trusted), strip it, filter chrome throughout the remaining body
# (not just the trailing end), and return what's left.
# ---------------------------------------------------------------------------

is_chrome_line() {
  local line="$1"
  # blank or pure box-drawing/separator (reuses the byte-safe check — see
  # its comment on bash 3.2's bracket-expression bug with multi-byte UTF-8)
  is_blank_or_separator_line "$line" && return 0
  # the persistent bottom status/footer bar (model name, context, timers)
  if [[ "$line" == *"⚕"* && "$line" == *"│"* ]]; then
    return 0
  fi
  # the idle prompt line itself
  if [[ "$line" =~ ❯$ ]]; then
    return 0
  fi
  # (I6) system/UI notices that are not "Hermes's new response text":
  # model-fallback-switch notices and the agent-initializing banner.
  if [[ "$line" == *"Switched to fallback model"* ]]; then
    return 0
  fi
  if [[ "$line" == *"Initializing agent"* ]]; then
    return 0
  fi
  # (I6/N4) box top/bottom border lines. These can carry a title mixed with
  # border chars (e.g. "╭─ ⚕ Hermes 19:10─...╮" or "┌─ Reasoning ──...─┐"),
  # so a pure-separator check alone won't catch them; only the interior of
  # a reasoning/response box is left as content, deliberately not
  # attempting to distinguish "reasoning" from "response" content beyond
  # that — out of scope for this round. Whitespace is stripped via
  # substitution BEFORE the glob check, not combined into one
  # `[[:space:]]*╭*`-style pattern — see is_box_top_border_line's comment
  # on the byte-alignment bug that combination hits.
  #
  # (N4) A real box border STARTS with an opening glyph AND ENDS with its
  # matching closing glyph ("╭───╮", "└───┘"). The original version only
  # checked the start, which silently ate real content that merely starts
  # with a similar glyph without being a border at all — confirmed live,
  # a directory-tree reply line like "└── main.py" was being dropped.
  # Requiring the matched CLOSING glyph too fixes that while still
  # catching genuine borders.
  local stripped_line="${line//[[:space:]]/}"
  case "$stripped_line" in
    ╭*╮|╰*╯|┌*┐|└*┘) return 0 ;;
  esac
  return 1
}

extract_response() {
  local pre_count="$1"
  shift
  local -a input_lines=("$@")

  local full
  full="$(capture_full)"

  # Trailing whitespace note: capture_visible (-p, no -J/-S) trims trailing
  # spaces per line, but capture_full (-J -S -) does NOT — confirmed
  # empirically (the idle-prompt line came back padded with trailing spaces
  # in the -J capture, which silently broke the "ends in ❯" chrome check
  # below until lines were rtrimmed here).
  local -a lines=()
  while IFS= read -r l; do
    l="${l%"${l##*[![:space:]]}"}"
    lines+=("$l")
  done <<<"$full"

  # (I5/N2) Locate the echoed-input block by content, anchored NEAR the
  # recorded pre-send position rather than searching the whole unbounded
  # history from the end. A precise line-count offset can't be trusted to
  # the exact line — capture-pane's fixed visible-pane-height padding plus
  # prompt_toolkit's in-place bottom-chrome redraw means new content can
  # land a few lines earlier than a "before" wc -l snapshot (confirmed
  # empirically, up to ~4 lines of jitter, never more). The margin was
  # originally 20, generous "to be safe" — but too generous: (N2) sending
  # the exact same message twice in a row put TWO marker-carrying echoes
  # inside that wide a window, and taking the FIRST one (as the prior
  # version did) anchored on the OLDER of the two, returning the previous
  # turn's answer instead of the new one. Tightened to the actual observed
  # jitter (~4 lines, +1 for rounding safety = 5) and switched to the LAST
  # match in the window, not the first — the two fixes work together: a
  # narrower window makes it far less likely a stale duplicate echo is
  # even inside it, and taking the last match (now that the "●"/"⚙️"
  # marker requirement below already rules out the model merely quoting
  # the request in its own prose) always prefers the most recent send.
  local margin=5
  local search_from=$(( pre_count - margin ))
  (( search_from < 0 )) && search_from=0

  # Also require a genuine echo marker: "●" for regular chat messages
  # (confirmed live, e.g. "● Reply with exactly: BRIDGE_OK") or "⚙️" for
  # slash commands (confirmed live, e.g. "⚙️  /help" — a different marker
  # than plain messages get). Matching the input text alone isn't enough
  # for a short/generic message: reproduced live sending "/help" right
  # after a prior exchange whose own footer/tip text happened to mention
  # "/help" too — that incidental substring match (inside the margin
  # window, un-prefixed) anchored the search one exchange too early and
  # leaked the previous turn's content into the response. Only a genuinely
  # echoed line gets one of these two markers, so pairing either with the
  # input-text match reliably picks a real echo — and scanning the WHOLE
  # window (not stopping at the first hit) to keep the LAST such match
  # picks the most recent one specifically (N2).
  local start_idx=-1
  local i
  for (( i=search_from; i<${#lines[@]}; i++ )); do
    if [[ ( "${lines[$i]}" == *"●"* || "${lines[$i]}" == *"⚙️"* ) \
          && "${lines[$i]}" == *"${input_lines[0]}"* ]]; then
      start_idx="$i"
    fi
  done

  # (I4) If the echo can't be located, fail distinctly instead of silently
  # printing the whole capture (or nothing useful) as if it were correct.
  if (( start_idx < 0 )); then
    err "hermes-bridge: could not locate the echoed input in the pane near the expected position; response extraction failed"
    return 1
  fi

  local echo_end=$(( start_idx + ${#input_lines[@]} ))
  (( echo_end > ${#lines[@]} )) && echo_end=${#lines[@]}

  local -a body=("${lines[@]:$echo_end}")

  # (I6) Filter chrome from the WHOLE body, not just the trailing end —
  # model-switch notices, "Initializing agent...", and box border lines can
  # appear in the middle of the new output too, and the brief requires
  # only "Hermes's new response text".
  local -a filtered=()
  local line
  for line in "${body[@]}"; do
    is_chrome_line "$line" && continue
    filtered+=("$line")
  done

  # (I3) `printf '%s\n' "${arr[@]}"` on an empty array is an unbound-
  # variable error under bash 3.2 + `set -u` — guard it. An empty result
  # (e.g. Hermes's own "Raw Means Raw"/NO_REPLY behavior) is a legitimate,
  # non-error outcome, not something to fail on.
  if (( ${#filtered[@]} > 0 )); then
    printf '%s\n' "${filtered[@]}"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Argument parsing helpers
# ---------------------------------------------------------------------------

# Parses --session/--timeout out of "$@", leaving remaining positional args
# in POSITIONAL[]. Sets SESSION and TIMEOUT globals.
TIMEOUT="$DEFAULT_TIMEOUT"
POSITIONAL=()

parse_common_opts() {
  POSITIONAL=()
  while (( "$#" )); do
    case "$1" in
      --session)
        [[ $# -ge 2 ]] || { err "hermes-bridge: --session requires a value"; exit 1; }
        SESSION="$2"
        shift 2
        ;;
      --timeout)
        [[ $# -ge 2 ]] || { err "hermes-bridge: --timeout requires a value"; exit 1; }
        TIMEOUT="$2"
        shift 2
        ;;
      *)
        POSITIONAL+=("$1")
        shift
        ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_start() {
  parse_common_opts "$@"
  set -- "${POSITIONAL[@]:-}"

  # (R2) --fresh forces a brand-new Hermes session, discarding any saved
  # id, instead of resuming a previous conversation.
  local fresh=false
  local p
  for p in "$@"; do
    [[ "$p" == "--fresh" ]] && fresh=true
  done
  $fresh && clear_session_id

  # (I11) Refuses to touch a pre-existing session under this name that
  # this script didn't create itself.
  require_managed_session_or_die

  # (R2) Resume the previously-saved Hermes session, if any, on any
  # (re)launch — crash recovery (dead-session respawn below) and a plain
  # start after a full stop both go through this same path, so a
  # conversation survives either kind of restart unless --fresh was asked
  # for. `--resume <id>` (verified live) continues the exact conversation;
  # `--continue [NAME]` resumes by name/most-recent instead and is not
  # what we want given we have a specific id.
  local resume_id=""
  $fresh || resume_id="$(load_session_id)"

  # (N1c) The id — whenever present — is only ever passed as an argv
  # element, NEVER interpolated into a string that gets typed into a live
  # shell via send-keys. respawn-pane already worked this way; the
  # create-new-session path below now does too WHENEVER a resume_id
  # exists (i.e. any relaunch after a full stop, not just crash recovery).
  # The typed-shell-string path is kept ONLY for the genuinely-first-ever
  # launch, where there is no id at all to interpolate — that string is a
  # fixed constant, never touched by anything scraped from Hermes's output.
  local -a launch_argv=(hermes chat --cli --source tool)
  if [[ -n "$resume_id" ]]; then
    launch_argv+=(--resume "$resume_id")
  fi

  if session_exists; then
    if pane_is_dead; then
      tmux respawn-pane -k -t "$SESSION" -- "${launch_argv[@]}"
      # Settle grace period: pane_is_dead's shell-name check (see its
      # comment) is briefly, legitimately true for a moment after any
      # (re)launch too — the pane IS just a shell until hermes actually
      # starts and takes over. Without this, wait_for_terminal's first poll
      # can misread the still-settling relaunch as an immediately-terminal
      # "dead" state. Confirmed live: a respawn-pane recovery failed this
      # way before this delay was added.
      sleep 3
    else
      local st
      st="$(classify_state)"
      echo "hermes-bridge: session '$SESSION' already running (state=$st)"
      return 0
    fi
  elif [[ -n "$resume_id" ]]; then
    # (N1c) Resuming a saved id but the tmux session itself doesn't exist
    # (e.g. after a full `stop`): launch hermes as the pane's own process
    # directly via new-session's own argv, never typed.
    tmux new-session -d -s "$SESSION" -x 220 -y 50 -- "${launch_argv[@]}"
    mark_session_managed
    sleep 3
  else
    tmux new-session -d -s "$SESSION" -x 220 -y 50
    mark_session_managed
    tmux send-keys -t "$SESSION" -l -- 'hermes chat --cli --source tool'
    tmux send-keys -t "$SESSION" Enter
    sleep 3
  fi

  local st
  st="$(wait_for_terminal "$TIMEOUT")"
  case "$st" in
    idle)
      # (R1) Capture + persist the session id on every successful reach-
      # idle, not just on a brand-new launch: a resumed session should
      # show the SAME id, and re-saving it is a cheap continuity check.
      # capture_session_id_from_pane legitimately returns non-zero when no
      # banner/id is found (e.g. a malformed id, or the banner already
      # scrolled out) — under `set -e`, a bare failing assignment like
      # this as its own statement kills the whole script (confirmed live,
      # same class of bug as load_session_id's earlier fix); `|| true`
      # neutralizes that without masking a real error, since "not found"
      # is an explicitly non-fatal outcome here (see the function's doc).
      local sid
      sid="$(capture_session_id_from_pane)" || true
      if [[ -n "$sid" ]]; then
        save_session_id "$sid" || true
      fi
      echo "hermes-bridge: session '$SESSION' started (state=idle)"
      return 0
      ;;
    approval|secret|clarify)
      err "hermes-bridge: needs-attention: $st"
      exit "$(state_exit_code "$st")"
      ;;
    *)
      err "hermes-bridge: $st"
      exit "$(state_exit_code "$st")"
      ;;
  esac
}

cmd_send() {
  parse_common_opts "$@"
  set -- "${POSITIONAL[@]:-}"
  if [[ $# -lt 1 || -z "${1:-}" ]]; then
    err "hermes-bridge: send requires MESSAGE"
    exit 1
  fi
  local message="$1"

  # (I7) A message containing an embedded newline sent through send-keys
  # would submit mid-message (Enter is bound to LF on a plain local tty —
  # see the paste-buffer -p note). Reject clearly rather than silently
  # truncating or guessing.
  if [[ "$message" == *$'\n'* ]]; then
    err "hermes-bridge: message contains a newline; use send-file instead"
    exit 1
  fi

  local pre_state
  pre_state="$(classify_state)"
  case "$pre_state" in
    missing|dead|approval|secret|clarify|busy)
      # (Fix-wave item 2) busy was previously allowed through: Hermes's own
      # busy-state hint is literally "msg=interrupt" (confirmed live in the
      # busy prompt line, "⚕ ❯ msg=interrupt · /queue · /bg · /steer ..."),
      # meaning typing a new message and Enter while busy doesn't queue it —
      # it INTERRUPTS whatever Hermes was already doing. Reject up front
      # with its own distinct exit code (8) rather than silently cancelling
      # in-flight work.
      err "$pre_state"
      exit "$(state_exit_code "$pre_state")"
      ;;
  esac

  require_managed_session_or_die

  local pre_count
  pre_count="$(capture_full | wc -l | tr -d ' ')"

  send_payload "$message"

  local st
  st="$(wait_for_terminal "$TIMEOUT" "$message")"
  if [[ "$st" == "idle" ]]; then
    if extract_response "$pre_count" "$message"; then
      return 0
    fi
    exit 1
  else
    err "$st"
    exit "$(state_exit_code "$st")"
  fi
}

cmd_send_file() {
  parse_common_opts "$@"
  set -- "${POSITIONAL[@]:-}"
  if [[ $# -lt 1 || -z "${1:-}" ]]; then
    err "hermes-bridge: send-file requires FILE"
    exit 1
  fi
  local file="$1"
  if [[ ! -r "$file" ]]; then
    err "hermes-bridge: cannot read file: $file"
    exit 1
  fi
  # (Fix-wave item 3) An empty file makes input_lines[0] (extract_response's
  # echo anchor) the empty string, and *""* matches every line trivially —
  # the echo-marker + text match degenerates into "first/last ●-or-⚙️
  # marked line in the search window", which can be the PREVIOUS turn's
  # echo rather than this send's. Reject clearly instead of risking that.
  if [[ ! -s "$file" ]]; then
    err "hermes-bridge: refusing to send an empty file: $file"
    exit 1
  fi

  local pre_state
  pre_state="$(classify_state)"
  case "$pre_state" in
    missing|dead|approval|secret|clarify|busy)
      # (Fix-wave item 2) busy was previously allowed through: Hermes's own
      # busy-state hint is literally "msg=interrupt" (confirmed live in the
      # busy prompt line, "⚕ ❯ msg=interrupt · /queue · /bg · /steer ..."),
      # meaning typing a new message and Enter while busy doesn't queue it —
      # it INTERRUPTS whatever Hermes was already doing. Reject up front
      # with its own distinct exit code (8) rather than silently cancelling
      # in-flight work.
      err "$pre_state"
      exit "$(state_exit_code "$pre_state")"
      ;;
  esac

  require_managed_session_or_die

  local content
  content="$(cat "$file")"

  local -a file_lines=()
  while IFS= read -r l; do
    file_lines+=("$l")
  done <<<"$content"

  local pre_count
  pre_count="$(capture_full | wc -l | tr -d ' ')"

  send_payload "$content"

  local st
  st="$(wait_for_terminal "$TIMEOUT" "${file_lines[0]:-}")"
  if [[ "$st" == "idle" ]]; then
    if extract_response "$pre_count" "${file_lines[@]}"; then
      return 0
    fi
    exit 1
  else
    err "$st"
    exit "$(state_exit_code "$st")"
  fi
}

cmd_wait() {
  parse_common_opts "$@"
  local st
  st="$(wait_for_terminal "$TIMEOUT")"
  echo "$st"
  exit "$(state_exit_code "$st")"
}

cmd_peek() {
  parse_common_opts "$@"
  set -- "${POSITIONAL[@]:-}"
  local lines=40
  # allow `-n N` inside positional leftovers
  while (( "$#" )); do
    case "$1" in
      -n)
        [[ $# -ge 2 ]] || { err "hermes-bridge: -n requires a value"; exit 1; }
        lines="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  if ! session_exists; then
    err "missing"
    exit 2
  fi
  tmux capture-pane -p -t "$SESSION" | tail -n "$lines"
}

cmd_state() {
  parse_common_opts "$@"
  classify_state
  exit 0
}

cmd_session() {
  parse_common_opts "$@"
  local sid
  sid="$(load_session_id)"
  if [[ -z "$sid" ]]; then
    err "hermes-bridge: no saved session id for '$SESSION'"
    exit 1
  fi
  echo "$sid"
}

cmd_approve_deny() {
  local action="$1"
  shift
  parse_common_opts "$@"
  set -- "${POSITIONAL[@]:-}"

  local st
  st="$(classify_state)"
  if [[ "$st" != "approval" ]]; then
    if [[ "$st" == "missing" || "$st" == "dead" ]]; then
      err "$st"
      exit "$(state_exit_code "$st")"
    fi
    err "hermes-bridge: not in approval state (current: $st)"
    exit 1
  fi

  require_managed_session_or_die

  # Deny reason (if any) is logged, not typed into the menu — the menu has
  # no text field, only numbered options (see the module comment above).
  local reason="$*"

  if ! read_menu; then
    err "hermes-bridge: approval state detected but no well-formed numbered menu could be resolved in the pane; refusing to act"
    exit 1
  fi

  local target_pattern target_num
  if [[ "$action" == "approve" ]]; then
    target_pattern="Allow once"
  else
    target_pattern="Deny"
  fi

  target_num="$(find_menu_option "$target_pattern")" || true
  if [[ -z "$target_num" ]]; then
    err "hermes-bridge: could not find a '$target_pattern' option in the approval menu; refusing to act"
    exit 1
  fi

  if ! select_menu_option_and_confirm "$target_num" "$target_pattern"; then
    err "hermes-bridge: could not confirm the cursor reached the '$target_pattern' option; refusing to press Enter"
    exit 1
  fi

  if [[ "$action" == "deny" && -n "$reason" ]]; then
    err "hermes-bridge: denied (reason: $reason)"
  fi

  local final_st
  final_st="$(wait_for_terminal "$DEFAULT_TIMEOUT")"
  echo "$final_st"
  exit "$(state_exit_code "$final_st")"
}

cmd_stop() {
  parse_common_opts "$@"

  if ! session_exists; then
    echo "hermes-bridge: no session"
    return 0
  fi

  # (I11) Refuse to touch a session under this name that hermes-bridge
  # didn't create.
  require_managed_session_or_die

  local st
  st="$(classify_state)"

  case "$st" in
    approval|secret|clarify)
      # (C1) NEVER type /exit (or anything else) into these states. Enter
      # would confirm whichever menu option is currently highlighted
      # (approval) or submit garbage into a secret/clarify prompt — the
      # exact accidental-approval failure mode this bridge exists to
      # prevent. Skip the /exit handshake entirely and go straight to
      # kill-session.
      err "hermes-bridge: skipping graceful /exit ($st state active — sending keys here could confirm a menu option or submit into a prompt); killing session directly"
      ;;
    dead)
      # (N5) hermes is already gone (crashed) — the pane is just its
      # leftover shell (or nothing useful). Typing Escape//exit/Enter into
      # it is pointless at best; go straight to kill-session like the
      # approval/secret/clarify branch above.
      err "hermes-bridge: session already dead; killing directly"
      ;;
    idle)
      tmux send-keys -t "$SESSION" -l -- '/exit'
      tmux send-keys -t "$SESSION" Enter
      local waited=0
      while (( waited < STOP_GRACE_SECONDS )) && session_exists; do
        sleep 0.5
        waited=$((waited + 1))
      done
      ;;
    *)
      # busy (or any other transitional/unknown state): Escape first to
      # interrupt in-flight work. Empirically, sending keys immediately
      # after Escape can race and drop the leading character of the next
      # send (observed once: "/exit" arriving as bare "exit" and being
      # treated as a chat message) — a short settle delay avoids this.
      tmux send-keys -t "$SESSION" Escape
      sleep 0.5
      # (Fix-wave item 1) TOCTOU: the state read at the top of this
      # function is stale by the time the settle sleep above elapses — an
      # approval/secret/clarify prompt can appear in that window (e.g. the
      # Escape itself, or whatever was in flight, resolves into one), and
      # blindly typing /exit + Enter into it would confirm the highlighted
      # menu option or submit into a secret/clarify prompt, exactly the
      # failure mode C1 exists to prevent. Re-check right before typing:
      # only proceed with /exit if the pane is STILL idle/busy; otherwise
      # skip straight to kill-session below, same as the approval/secret/
      # clarify/dead branches above.
      local st_after_settle
      st_after_settle="$(classify_state)"
      case "$st_after_settle" in
        idle|busy)
          tmux send-keys -t "$SESSION" -l -- '/exit'
          tmux send-keys -t "$SESSION" Enter
          local waited=0
          while (( waited < STOP_GRACE_SECONDS )) && session_exists; do
            sleep 0.5
            waited=$((waited + 1))
          done
          ;;
        *)
          err "hermes-bridge: skipping /exit (state became '$st_after_settle' during the settle delay — sending keys here could confirm a menu option or submit into a prompt); killing session directly"
          ;;
      esac
      ;;
  esac

  # Always force cleanup: /exit alone leaves the tmux session alive (its
  # pane reverts to the underlying shell rather than closing), so an
  # unconditional kill-session is required, not just a timeout fallback —
  # and it's also the only cleanup step for the approval/secret/clarify
  # branch above.
  tmux kill-session -t "$SESSION" 2>/dev/null || true

  echo "hermes-bridge: stopped"
}

cmd_log() {
  local lines=50
  while (( "$#" )); do
    case "$1" in
      -n)
        [[ $# -ge 2 ]] || { err "hermes-bridge: -n requires a value"; exit 1; }
        lines="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  if [[ ! -r "$HERMES_LOG" ]]; then
    err "hermes-bridge: log file not found: $HERMES_LOG"
    exit 1
  fi
  tail -n "$lines" "$HERMES_LOG"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi
  local cmd="$1"
  shift

  case "$cmd" in
    start) cmd_start "$@" ;;
    send) cmd_send "$@" ;;
    send-file) cmd_send_file "$@" ;;
    wait) cmd_wait "$@" ;;
    peek) cmd_peek "$@" ;;
    state) cmd_state "$@" ;;
    session) cmd_session "$@" ;;
    approve) cmd_approve_deny approve "$@" ;;
    deny) cmd_approve_deny deny "$@" ;;
    stop) cmd_stop "$@" ;;
    log) cmd_log "$@" ;;
    -h|--help|help) usage ;;
    *)
      err "hermes-bridge: unknown command: $cmd"
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
